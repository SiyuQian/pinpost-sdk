    "@types/react-native": "^0.72.8",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.5",
    "react-native-svg": "^15.15.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
